# ---------------------------------------------------------------------------
# captain-foxv1 — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#   npm run forge -- secrets      # generates fresh values for the bottom block
#
# .env.local is gitignored. Every value committed in THIS file is a public
# placeholder — never reuse one for anything real.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> API.
# Use the ANON key. The service_role key must never appear in this project:
# the lab's whole argument is that RLS, not a privileged key, is the boundary.
# After running supabase/schema.sql, add `captain_fox` to
# Project Settings -> API -> "Exposed schemas", or every query will fail.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Anthropic --------------------------------------------------------------
# Only needed for the "✦ CLAUDE" adversary toggle in the UI. The default
# "⚙ SCRIPTED" adversary and the whole test suite run without it.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Lab secrets ------------------------------------------------------------
# Replace both with `npm run forge -- secrets` output.
#
# FRK36_CIPHER_SEED seeds the function-state telemetry cipher. Change it and
# the same directive packs into entirely different "sensor readings".
FRK36_CIPHER_SEED="FAWAZ_RUFAI_KUNLE_36"
#
# AGENT_AUTH_SECRET is the HMAC-SHA256 key both simulated agents sign with.
# It proves *who sent* a manifest — never that the manifest is safe.
AGENT_AUTH_SECRET="captain-foxv1-thamesfreight-hmac-secret"

# --- Your own Morse key (optional) ------------------------------------------
# Both are unset by default, which means the lab uses standard ITU Morse.
# See docs/BUILD-YOUR-OWN-MORSE-KEY.md.
#
# Option A — share a passphrase; each machine rebuilds the same key:
#   npm run forge -- derive "your long passphrase"
# MORSE_KEY_PASSPHRASE="your long passphrase"
#
# Option B — pin the exact table (one line; takes priority over option A):
# MORSE_KEY='{"name":"MK-xxxxxxxx","symbols":{...},"separators":{...},"map":{...}}'
